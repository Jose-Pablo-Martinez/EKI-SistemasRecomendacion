# ─── Configuración de Base de Datos ──────────────────────────────────────────
# Datos para la conexión (Producción o Local)
DB_HOST=tu_host_aqui
DB_PORT=tu_puerto_aqui
DB_NAME=tu_nombre_db_aqui
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_password_aqui

# Ruta al certificado SSL (si se requiere, ej. para Aiven)
# Ejemplo: secrets/ca.pem
DB_SSL_CA=tu_ruta_al_certificado_aqui

# ─── Configuración de API ──────────────────────────────────────────────────
# Orígenes permitidos para CORS (ejemplo: http://localhost:5500)
CORS_ORIGINS=tu_url_frontend_aqui
